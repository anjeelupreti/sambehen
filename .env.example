# ========================================
# Application
# ========================================
NODE_ENV=development
APP_NAME=dpay
APP_PORT=3000
APP_HOST=0.0.0.0
API_PREFIX=api
API_VERSION=1
APP_CORS_ORIGIN=http://localhost:3000

# ========================================
# Database (PostgreSQL)
# ========================================
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=dpay
DB_SSL=false
DB_POOL_MIN=2
DB_POOL_MAX=10

# ========================================
# Redis
# ========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TTL=300

# ========================================
# JWT
# ========================================
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_REFRESH_EXPIRES_IN=7d

# ========================================
# Rate Limiting
# ========================================
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# ========================================
# Logging
# ========================================
LOG_LEVEL=debug

# ========================================
# Swagger
# ========================================
SWAGGER_ENABLED=true
SWAGGER_TITLE=DPay API
SWAGGER_DESCRIPTION=Enterprise DPay API Documentation
SWAGGER_VERSION=1.0
