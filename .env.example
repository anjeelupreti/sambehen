# ============================================================
# Sambehen - Data Entry Management System
# Copy to .env and fill in. Every variable here is validated by
# src/config/validation.schema.ts at boot; a missing required value
# fails startup rather than surfacing later as a runtime error.
# ============================================================

# -- Application ---------------------------------------------
NODE_ENV=development
APP_NAME=sambehen
APP_PORT=3000
APP_HOST=0.0.0.0
API_PREFIX=api
API_VERSION=1
# Comma-separated origins, or * to allow any (development only).
APP_CORS_ORIGIN=http://localhost:3000
# Public origin used to build referral, unsubscribe and download links.
APP_PUBLIC_URL=http://localhost:3000

# -- Database (PostgreSQL) -----------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=sambehen
DB_SSL=false
DB_POOL_MIN=2
DB_POOL_MAX=10

# -- Redis (cache, throttling, presence) ---------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TTL=300

# -- JWT -----------------------------------------------------
# Four DISTINCT secrets, minimum 32 characters each.
# Team and customer realms must never share a secret: separate secrets are
# what make a customer token fail signature verification on a team route,
# instead of relying on a claim check a forged payload could satisfy.
# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-team-access-secret-at-least-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-team-refresh-secret-at-least-32-chars
JWT_REFRESH_EXPIRES_IN=7d
JWT_CUSTOMER_SECRET=change-me-customer-access-secret-at-least-32-chars
JWT_CUSTOMER_EXPIRES_IN=30m
JWT_CUSTOMER_REFRESH_SECRET=change-me-customer-refresh-secret-at-least-32
JWT_CUSTOMER_REFRESH_EXPIRES_IN=30d

# -- Rate limiting -------------------------------------------
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# -- Mail (SMTP) ---------------------------------------------
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=no-reply@sambehen.local
MAIL_FROM_NAME=Sambehen
# Recipients drained per dispatcher tick.
EMAIL_BATCH_SIZE=50

# -- Business rules ------------------------------------------
# A customer counts as "active" when last seen within this many days.
ACTIVE_CUSTOMER_WINDOW_DAYS=30
# Boundary between the high-spender and low-spender email filters.
HIGH_SPENDER_THRESHOLD=250.00
REFERRAL_LINK_BASE_URL=http://localhost:3000/r

# -- Exports -------------------------------------------------
# Exports up to this many rows stream synchronously; larger ones return
# 202 with a job id and are built in the background.
EXPORT_SYNC_ROW_LIMIT=50000
EXPORT_RETENTION_HOURS=48
EXPORT_STORAGE_PATH=./storage/exports
# Excel has no timezone concept, so date cells commit to one.
EXPORT_TIMEZONE=UTC

# -- Logging -------------------------------------------------
LOG_LEVEL=debug

# -- Swagger -------------------------------------------------
# Set to false in production: the docs expose the full surface area,
# including every error code and filter parameter.
SWAGGER_ENABLED=true
SWAGGER_TITLE=Sambehen API
SWAGGER_DESCRIPTION=Data Entry Management System API
SWAGGER_VERSION=1.0
