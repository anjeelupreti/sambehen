# The repo holds two applications, each with its own toolchain and its own
# node_modules. Neither can lint the other's files, so each runs lint-staged
# on the subset of the commit that belongs to it.
#
# `--no-install` keeps a missing dependency an obvious failure rather than a
# silent download. A workspace that has not been installed is skipped, so
# working in one of them does not require installing both.
for workspace in backend frontend; do
  if [ -f "$workspace/package.json" ] && [ -d "$workspace/node_modules" ]; then
    (cd "$workspace" && npx --no-install lint-staged) || exit 1
  fi
done
