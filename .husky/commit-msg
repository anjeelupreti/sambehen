# One commit convention for the whole repo, enforced from backend/ because
# that is where commitlint and its shareable config are installed. The rule
# set applies to every commit regardless of which application it touches.
#
# The message path is resolved to an absolute one first. Git passes it
# relative to the repo root, but commitlint resolves relative paths against
# the git root it detects rather than against its own cwd — so handing it a
# relative path from inside backend/ lands a directory too high.
case "$1" in
  /* | [A-Za-z]:*) msg_file="$1" ;;
  *) msg_file="$(pwd)/$1" ;;
esac

(cd backend && npx --no -- commitlint --edit "$msg_file")
