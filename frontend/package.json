{
  "name": "sambehen-frontend",
  "version": "1.0.0",
  "private": true,
  "description": "Next.js frontend for the Sambehen data entry management system",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:check": "next lint --max-warnings 0",
    "type-check": "tsc --noEmit",
    "types:api": "cd ../backend && npm run docs:openapi && cd ../frontend && openapi-typescript ../backend/openapi.json -o lib/api-schema.d.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.7.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^0.475.0",
    "next": "^15.1.7",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.84.0",
    "recharts": "^3.10.1",
    "socket.io-client": "^4.8.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@tailwindcss/postcss": "^4.0.6",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "eslint": "^9.20.1",
    "eslint-config-next": "^15.1.7",
    "lint-staged": "^15.4.3",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.5.1",
    "tailwindcss": "^4.0.6",
    "tw-animate-css": "^1.2.4",
    "typescript": "^5.7.3"
  }
}
