# ─────────────────────────────────────────────────────────────
# Frontend configuration
#
# Copy to .env.local for local development. Anything prefixed with
# NEXT_PUBLIC_ is inlined into the browser bundle at build time — never put
# a secret behind that prefix.
# ─────────────────────────────────────────────────────────────

# Where the API lives. Server-side only: the browser never calls the API
# directly, so this is not NEXT_PUBLIC_ and never reaches the client.
# In production this is your deployed backend, e.g. https://api.example.com
API_URL=http://localhost:3000

# Version prefix on every API route. Matches API_PREFIX + API_VERSION in
# the backend's .env.
API_PREFIX=/api/v1

# Display formatting. Safe to expose — these are presentation choices, not
# secrets. Money is formatted for display only; it is never parsed into a
# number for arithmetic.
NEXT_PUBLIC_CURRENCY=USD
NEXT_PUBLIC_LOCALE=en-US
