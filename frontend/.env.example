# ─────────────────────────────────────────────────────────────
# Frontend configuration
#
# Copy to .env.local for local development. Anything prefixed with
# NEXT_PUBLIC_ is inlined into the browser bundle at build time — never put
# a secret behind that prefix.
# ─────────────────────────────────────────────────────────────

# Where the API lives. Server-side only: the browser never calls the API
# directly, so this is not NEXT_PUBLIC_ and never reaches the client.
# In production this is your deployed backend, e.g. https://api.example.com
API_URL=http://127.0.0.1:3001

# Version prefix on every API route. Matches API_PREFIX + API_VERSION in
# the backend's .env.
API_PREFIX=/api/v1

# Display formatting. Safe to expose — these are presentation choices, not
# secrets. Money is formatted for display only; it is never parsed into a
# number for arithmetic.
NEXT_PUBLIC_CURRENCY=USD
NEXT_PUBLIC_LOCALE=en-US

# Where the browser opens the messaging WebSocket. Unlike API_URL this is
# NEXT_PUBLIC_ and reaches the browser, because the socket is opened by the
# browser rather than by this server. It is a URL, not a secret.
NEXT_PUBLIC_WS_URL=http://127.0.0.1:3001

# Cloudflare R2, for uploaded files (game covers, message attachments).
# Required in any deployment: Vercel cannot write to disk, and production
# Next.js does not serve files added to public/ after the build. Leave all
# five empty in local dev to store uploads in public/uploads instead.
# R2_PUBLIC_URL is the bucket's public base URL (its r2.dev URL or a custom
# domain), with no trailing slash. Server-side only, never NEXT_PUBLIC_.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
