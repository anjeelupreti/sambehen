# Generated .xlsx/.csv export artifacts (see EXPORT_STORAGE_PATH).
storage/
uploads/
tmp/

# ── Testing ──────────────────────────────────────────────────
coverage/
.nyc_output/

# ── Logs ─────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-error.log*

# ── Tooling caches ───────────────────────────────────────────
.eslintcache
.cache/

# ── Docker ───────────────────────────────────────────────────
docker-compose.override.yml

# ── IDE / OS ─────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# ── AI assistant workspaces ──────────────────────────────────
.claude/
.agents/
.windsurf/
skills-lock.json

# NOTE: intentionally NOT ignored —
#   package-lock.json          reproducible installs in CI and prod
