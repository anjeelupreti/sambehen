# Normalize line endings: LF in the repository, native in the working tree.
# Prevents CRLF churn between Windows dev machines and Linux CI/containers.
* text=auto eol=lf

# Shell scripts and git hooks must stay LF or they break inside containers.
*.sh        text eol=lf
.husky/*    text eol=lf

# Windows-only scripts keep CRLF.
*.bat       text eol=crlf
*.cmd       text eol=crlf

# Treat as binary — never diff or line-ending-convert.
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.pdf       binary
*.xlsx      binary
*.woff      binary
*.woff2     binary

# Collapse generated files in diffs and PR reviews.
package-lock.json                  linguist-generated=true -diff
backend/src/database/migrations/** linguist-generated=true
